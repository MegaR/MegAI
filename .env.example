TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie

# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# OpenAI Configuration
# Get your API key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
# Optional: Custom base URL for OpenAI API (e.g., for proxies or alternative endpoints)
OPENAI_BASE_URL=
# Optional: Default model to use for chat completions (defaults to gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini
# Optional: Number of previous messages to include in chat context (defaults to 10)
CHAT_HISTORY_LIMIT=10
